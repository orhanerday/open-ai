{
    "name": "orhanerday/open-ai",
    "description": "OpenAI API client for PHP, with Responses, Chat, Images, and more",
    "keywords": [
        "orhanerday",
        "open-ai"
    ],
    "homepage": "https://github.com/orhanerday/open-ai",
    "license": "MIT",
    "authors": [
        {
            "name": "Orhan Erday",
            "email": "orhanerday@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^1.23.1 || ^2.0 || ^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Orhanerday\\OpenAi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orhanerday\\OpenAi\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-live": "vendor/bin/pest --group=live",
        "test-coverage": "vendor/bin/pest --exclude-group=live --coverage --coverage-filter=src --coverage-html=build/coverage --coverage-clover=build/logs/clover.xml",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
